{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlankSlate",
  "version": "0.1.5",
  "identifier": "dev.blankslate.hud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BlankSlate",
        "width": 380,
        "height": 620,
        "minWidth": 320,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "BlankSlate HUD",
    "longDescription": "A private, local-first AI voice assistant overlay.",
    "resources": {
      "resources/daemon/": "daemon",
      "resources/ollama/": "ollama"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}